APP_NAME="Kontur AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- База данных ---------------------------------------------------------
# По умолчанию SQLite — запуск без инфраструктуры.
# В Docker/Makefile переопределяется на mysql (см. docker-compose.yml).
DB_CONNECTION=sqlite
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=secret

# --- Сессии и кеш --------------------------------------------------------
# В продакшене: redis. Локально можно оставить database/файл.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# --- Файлы ---------------------------------------------------------------
FILESYSTEM_DISK=local
ASSETS_DISK=local

# --- Очереди -------------------------------------------------------------
# database — без Redis; redis — как в docker-compose.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- AI-провайдеры -------------------------------------------------------
# stub — локальная генерация без ключей; openai — любой OpenAI-совместимый шлюз.
AI_PROVIDER=stub
AI_STUB_DELAY_MS=400
AI_MAX_PROMPT_LENGTH=2000
AI_RETRY_TRIES=3

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# --- Билинг --------------------------------------------------------------
BILLING_DEFAULT_CREDITS=500

# --- SSR -----------------------------------------------------------------
# Включается, когда запущен `php artisan inertia:start-ssr` (или контейнер ssr).
# Без собранного бандла (npm run build) и запущенного рендерера страницы
# отдаются клиентским рендером — приложение остаётся рабочим.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_TIMEOUT=5
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kontur.ai"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"